+    func testMCPBrowserAnswerCheckRejectsMissingSourceAndCancelledWorkBeforeInference() async throws {
+        let trace = MCPBrowserLoopTrace()
+        let planner = ComputerUseMCPBrowserStepPlanner(inspectProposal: { trace.append($0) })
+        let context = ComputerUseMCPBrowserStepPlanner.Context(json: #"{"goal":"Read the note","page":{"url":"https://example.org/observed"}}"#,
+            schema: .object([:]), userURLs: [:], links: [:], answerTexts: ["Known note"], answerSources: ["https://example.org/observed"])
+        do { _ = try await planner.verifyAnswer("Known note", context: context); XCTFail("Missing source must reject") }
+        catch ComputerUseMCPBrowserStepPlanner.Failure.unsupportedAnswerClaim { }
+        let cancelled = Task {
+            withUnsafeCurrentTask { $0?.cancel() }
+            return try await planner.verifyAnswer("Known note https://example.org/observed", context: context)
+        }
+        do { _ = try await cancelled.value; XCTFail("Cancellation must reject") } catch is CancellationError { }
+        XCTAssertTrue(trace.items.isEmpty, "Neither request may enter model counting or generation")
+    }
