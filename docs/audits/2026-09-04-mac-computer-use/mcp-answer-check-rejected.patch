+    func testMCPBrowserAnswerCitationUsesOnlyTheCurrentObservedSource() throws {
+        let planner = ComputerUseMCPBrowserStepPlanner(), source = "https://example.org/observed"
+        let context = ComputerUseMCPBrowserStepPlanner.Context(json: #"{"page":{"url":"https://example.org/observed"}}"#,
+            schema: .object([:]), userURLs: ["user-url-1": URL(string: "https://unvisited.invalid/")!], links: [:],
+            answerTexts: ["東京 café — published information"], answerSources: [source])
+        let answer = "東京 café — published information"
+        XCTAssertEqual(try planner.answerWithNativeSource(answer, context: context), answer + "\n\nSource: " + source)
+        let cited = answer + " [Page](" + source + ")"
+        XCTAssertEqual(try planner.answerWithNativeSource(cited, context: context), cited)
+        XCTAssertThrowsError(try planner.answerWithNativeSource(answer + " https://unvisited.invalid/", context: context))
+        var changed = context
+        changed = .init(json: #"{"page":{"url":"https://unvisited.invalid/"}}"#, schema: .object([:]),
+            userURLs: context.userURLs, links: [:], answerTexts: context.answerTexts, answerSources: context.answerSources)
+        XCTAssertThrowsError(try planner.answerWithNativeSource(answer, context: changed))
+        XCTAssertThrowsError(try planner.answerWithNativeSource(String(repeating: "界", count: 1365), context: context))
+    }
