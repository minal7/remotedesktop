+    func testOptInMCPAnswerAdmissionOnFrozenNativeEvidence() async throws {
+        guard ProcessInfo.processInfo.environment["RUN_MCP_ANSWER_CHECK"] == "1" else {
+            throw XCTSkip("Opt-in: bounded actual Apple answer checking over frozen native records, without effects")
+        }
+        let manifestURL = URL(fileURLWithPath: try XCTUnwrap(ProcessInfo.processInfo.environment["MCP_ANSWER_CHECK_MANIFEST"]))
+        let manifest = try XCTUnwrap(JSONSerialization.jsonObject(with: Data(contentsOf: manifestURL)) as? [String: Any])
+        let pages = try XCTUnwrap(manifest["pages"] as? [String: [String: Any]])
+        let cases = try XCTUnwrap(manifest["cases"] as? [[String: Any]])
+        let directory = URL(fileURLWithPath: try XCTUnwrap(ProcessInfo.processInfo.environment["MCP_BROWSER_LOOP_DIRECTORY"]))
+        try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: false)
+        var reports: [[String: Any]] = []
+        for item in cases {
+            let id = try XCTUnwrap(item["id"] as? String), key = try XCTUnwrap(item["page"] as? String)
+            let pageInfo = try XCTUnwrap(pages[key]), goal = try XCTUnwrap(item["goal"] as? String)
+            let answer = try XCTUnwrap(item["answer"] as? String), expected = try XCTUnwrap(item["expected"] as? Bool)
+            let path = try XCTUnwrap(pageInfo["catalogue"] as? String), url = try XCTUnwrap(pageInfo["url"] as? String)
+            let page = try JSONDecoder().decode(ComputerUseBrowserPageSnapshot.self, from: Data(contentsOf: URL(fileURLWithPath: path)))
+            let windows = try ComputerUseMCPBrowserStepPlanner.recordWindows(page)
+            let first = try XCTUnwrap(windows.first)
+            var records = first.object
+            records["url"] = url; records["truncated"] = page.truncated
+            records["recordWindow"] = ["number": 1, "total": windows.count]
+            let encoded = try JSONSerialization.data(withJSONObject: ["goal": goal, "page": records], options: [.sortedKeys, .withoutEscapingSlashes])
+            let context = ComputerUseMCPBrowserStepPlanner.Context(json: String(decoding: encoded, as: UTF8.self), schema: .object([:]),
+                userURLs: [:], links: Dictionary(uniqueKeysWithValues: first.links.map { ($0.id, $0) }),
+                answerTexts: first.texts.map(\.pageReadingText), answerSources: Set([url] + first.links.map(\.destination)),
+                isPartialRecordView: windows.count > 1)
+            let trace = MCPBrowserLoopTrace(), started = Date()
+            var accepted = false, errorText: String?
+            do { accepted = try await ComputerUseMCPBrowserStepPlanner(inspectProposal: { trace.append($0) }).verifyAnswer(answer, context: context) }
+            catch ComputerUseMCPBrowserStepPlanner.Failure.unsupportedAnswerClaim { accepted = false; trace.append("Scalar/source precheck rejected") }
+            catch { errorText = String(reflecting: error) }
+            let matches = errorText == nil && accepted == expected
+            reports.append(["id": id, "expected": expected, "accepted": accepted, "matches": matches,
+                "error": errorText as Any? ?? NSNull(), "trace": trace.items, "seconds": Date().timeIntervalSince(started)])
+            try JSONSerialization.data(withJSONObject: ["cases": reports, "plannedCount": cases.count], options: [.prettyPrinted, .sortedKeys])
+                .write(to: directory.appendingPathComponent("result.json"), options: .atomic)
+            guard matches else { return XCTFail("Frozen answer admission mismatch: \(id); \(errorText ?? String(accepted))") }
+        }
+    }
