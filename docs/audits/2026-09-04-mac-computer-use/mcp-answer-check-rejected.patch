+    /// Supply an omitted citation from the exact current observation, never
+    /// from generated memory or a user-supplied URL that was not visited.
+    func answerWithNativeSource(_ answer: String, context: Context) throws -> String {
+        try validateAnswerClaims(answer, context: context)
+        let detector = try NSDataDetector(types: NSTextCheckingResult.CheckingType.link.rawValue)
+        if !detector.matches(in: answer, range: NSRange(location: 0, length: (answer as NSString).length)).isEmpty { return answer }
+        guard context.json.utf8.count <= 48 * 1024,
+              let object = try JSONSerialization.jsonObject(with: Data(context.json.utf8)) as? [String: Any],
+              let page = object["page"] as? [String: Any], let source = page["url"] as? String,
+              context.answerSources.contains(source), let url = URL(string: source),
+              ComputerUseOwnedBrowser.validatedURL(url) != nil else {
+            throw Failure.unsupportedAnswerClaim
+        }
+        let result = answer + "\n\nSource: " + source
+        guard result.utf8.count <= 4096 else { throw AppleFoundationMCPPlannerError.responseTooLarge }
+        return result
