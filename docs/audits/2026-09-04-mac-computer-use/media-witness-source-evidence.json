  "findings": [
    {
      "id": "local-factory-pass-through",
      "status": "current app source",
      "detail": "DesktopVideoEncoderFactory and DesktopVideoDecoderFactory return the default codec objects; the app has no encoded-frame witness hook."
    },
    {
      "id": "objc-callback-boundaries",
      "status": "headers and reference source; native unqualified",
      "detail": "Public encoder/decoder protocols expose encoded buffers and callbacks. Native-builder codecs can bypass the Objective-C adapter; H264 is selected as an Objective-C codec in the reviewed default-factory source."
    },
    {
      "id": "parameter-rewrite",
      "status": "reference source; installed binary unverified",
      "detail": "Incoming H264 depacketization may rewrite SPS VUI and STAP-A lengths. Parameter tracking may insert stored SPS/PPS before an IDR. An unqualified digest of whole encoder/decoder buffers is not a usable identity comparison."
    },
    {
      "id": "decode-request-correlation",
      "status": "reference source; installed binary unverified",
      "detail": "H264 decode request parameters retain the callback and input RTP timestamp through asynchronous output; the Objective-C native bridge reconstructs frame time with timestamp_ms zero."
    },
    {
      "id": "decoder-availability-is-not-success",
      "status": "reference source; installed binary unverified",
      "detail": "Decode can return success before asynchronous output, can fail without producing a frame, and can reset/retry a native session. Native decode admission alone cannot reopen input."
    },
    {
      "id": "version-label-is-insufficient",
      "status": "local framework metadata",
      "detail": "Framework bundle versions are 1.0. Header hashes and package pin do not prove the binary source revision or executed codec path."
    }
  ],
  "qualification": "No end-to-end capture/encode/RTP/decode/presentation witness is implemented or qualified by this evidence file."
