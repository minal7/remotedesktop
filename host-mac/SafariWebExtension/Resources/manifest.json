{
  "manifest_version": 3,
  "name": "Remote Desktop Computer Use Bridge",
  "version": "2.0.0",
  "description": "Task-scoped Safari transport for Remote Desktop Computer Use.",
  "permissions": [
    "nativeMessaging",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://[::1]/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "http://[::1]/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "browser_specific_settings": {
    "safari": {
      "strict_min_version": "17.0"
    }
  }
}
