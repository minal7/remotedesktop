{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "observation.schema.json",
  "title": "Computer-use observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task",
    "surface",
    "screenshot",
    "elements",
    "focus",
    "history",
    "budget"
  ],
  "properties": {
    "task": {
      "type": "string"
    },
    "surface": {
      "$ref": "#/$defs/surface"
    },
    "screenshot": {
      "type": "string",
      "minLength": 1
    },
    "elements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/element"
      }
    },
    "focus": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/focus"
        }
      ]
    },
    "history": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/historyItem"
      }
    },
    "budget": {
      "$ref": "#/$defs/budget"
    }
  },
  "$defs": {
    "surface": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "url"
          ],
          "properties": {
            "kind": {
              "const": "web"
            },
            "url": {
              "type": "string",
              "minLength": 1
            },
            "title": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "app"
          ],
          "properties": {
            "kind": {
              "const": "app"
            },
            "app": {
              "type": "string",
              "minLength": 1
            },
            "title": {
              "type": "string"
            }
          }
        }
      ]
    },
    "element": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "name",
        "value",
        "state",
        "bbox",
        "in_view"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0
        },
        "role": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "value": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bbox": {
          "$ref": "#/$defs/bbox"
        },
        "in_view": {
          "type": "boolean"
        }
      }
    },
    "focus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "name",
        "value_prefix",
        "selection"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0
        },
        "role": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "value_prefix": {
          "type": "string"
        },
        "selection": {
          "$ref": "#/$defs/selection"
        }
      }
    },
    "bbox": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "number",
          "minimum": 0
        }
      ],
      "minItems": 4,
      "maxItems": 4
    },
    "selection": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "integer",
          "minimum": 0
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "historyItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "result"
      ],
      "properties": {
        "action": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "action.schema.json#/$defs/action"
            }
          ]
        },
        "result": {
          "type": "string"
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step",
        "max_steps"
      ],
      "properties": {
        "step": {
          "type": "integer",
          "minimum": 0
        },
        "max_steps": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
