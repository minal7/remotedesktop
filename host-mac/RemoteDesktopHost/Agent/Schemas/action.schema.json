{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "action.schema.json",
  "title": "Computer-use action",
  "$ref": "#/$defs/action",
  "$defs": {
    "target": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["id"], "properties": {"id": {"type": "integer", "minimum": 0}}},
        {"type": "object", "additionalProperties": false, "required": ["x", "y"], "properties": {"x": {"type": "number"}, "y": {"type": "number"}}}
      ]
    },
    "action": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["type", "target"], "properties": {"type": {"const": "click"}, "target": {"$ref": "#/$defs/target"}, "button": {"enum": ["left", "middle", "right"]}, "count": {"type": "integer", "minimum": 1}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "text", "mode"], "properties": {"type": {"const": "type"}, "target": {"$ref": "#/$defs/target"}, "text": {"type": "string"}, "mode": {"enum": ["replace", "append"]}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "chord"], "properties": {"type": {"const": "key"}, "chord": {"type": "string", "minLength": 1}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "direction", "amount"], "properties": {"type": {"const": "scroll"}, "target": {"$ref": "#/$defs/target"}, "direction": {"enum": ["up", "down", "left", "right"]}, "amount": {"type": "number", "exclusiveMinimum": 0}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "target", "option"], "properties": {"type": {"const": "select"}, "target": {"$ref": "#/$defs/target"}, "option": {"type": "string"}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "from", "to"], "properties": {"type": {"const": "drag"}, "from": {"$ref": "#/$defs/target"}, "to": {"$ref": "#/$defs/target"}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "url"], "properties": {"type": {"const": "open_url"}, "url": {"type": "string", "format": "uri", "minLength": 1}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "name"], "properties": {"type": {"const": "open_app"}, "name": {"type": "string", "minLength": 1}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "query"], "properties": {"type": {"const": "find_files"}, "query": {"type": "string"}, "kind": {"type": "string"}, "modified_after": {"type": "string", "format": "date-time"}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "target", "file_ids"], "properties": {"type": {"const": "set_files"}, "target": {"$ref": "#/$defs/target"}, "file_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "seconds"], "properties": {"type": {"const": "wait"}, "seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 10}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "question"], "properties": {"type": {"const": "ask_user"}, "question": {"type": "string", "minLength": 1}, "choices": {"type": "array", "items": {"type": "string"}}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "answer"], "properties": {"type": {"const": "done"}, "answer": {"type": "string"}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "reason"], "properties": {"type": {"const": "fail"}, "reason": {"type": "string", "minLength": 1}}}
      ]
    }
  }
}
